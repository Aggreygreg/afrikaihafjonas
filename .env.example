# ── Afrikai Hajfonás — Environment Configuration ──────────────
# Copy this file to .env and fill in production values.
# In development, all values have sensible defaults (except SECRET_KEY).

# REQUIRED — Django secret key. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Set to True for local development, False for production.
DEBUG=False

# Comma-separated list of allowed hostnames.
# Example: afrikaihajfonas.hu,www.afrikaihajfonas.hu
ALLOWED_HOSTS=

# Database URL (dj-database-url format).
# PostgreSQL (production):
#   postgres://USER:PASSWORD@HOST:PORT/DBNAME
# SQLite (development):
#   sqlite:///db.sqlite3
DATABASE_URL=

# ── Email ─────────────────────────────────────────────────────
# Console backend (dev) prints emails to terminal:
#   django.core.mail.backends.console.EmailBackend
# SMTP backend (production):
#   django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@afrikaihajfonas.hu

# ── CSRF ──────────────────────────────────────────────────────
# Comma-separated list of trusted origins for POST requests over HTTPS.
# Example: https://afrikaihajfonas.hu,https://www.afrikaihajfonas.hu
CSRF_TRUSTED_ORIGINS=

# ── HSTS ──────────────────────────────────────────────────────
# HSTS max-age in seconds. Default: 1 year (31536000).
# Set to 0 to disable HSTS during initial HTTPS testing.
SECURE_HSTS_SECONDS=31536000
